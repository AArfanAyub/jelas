<?xml version="1.0" encoding="utf-8"?>
<!-- JELAS never uses the network. This config blocks everything as a second line of defence. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
